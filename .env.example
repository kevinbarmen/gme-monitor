# Скопируйте в .env и заполните. .env не коммитится.

# Отдельный бот для GME (новый токен через @BotFather — НЕ токен бота CS2)
GME_TG_BOT_TOKEN=
GME_TG_CHAT_ID=

# Claude API (скоринг раз в день)
ANTHROPIC_API_KEY=

# SEC требует User-Agent с контактом: "имя email"
SEC_USER_AGENT="gme-monitor your-name your@email.com"

# Heartbeat — можно тот же GME-бот или отдельный
HEARTBEAT_TG_BOT_TOKEN=
HEARTBEAT_TG_CHAT_ID=

# Reddit OAuth (опционально, приложение типа script на reddit.com/prefs/apps).
# Без него работает RSS-режим: без апвотов и без алерта по апвот-темпу.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
